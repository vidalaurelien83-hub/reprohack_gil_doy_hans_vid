Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    Tool clusterProfiler
    Version clusterProfiler 3.14.0 / org.Mm.eg.db 3.10.0
    R_Version 3.6
    Bioconductor_Version 3.10
    Source bioconda

%help
    R 3.6 + clusterProfiler 3.14.0 et org.Mm.eg.db 3.10.0 (Bioconductor 3.10,
    même génération que DESeq2 1.26.0). Analyse fonctionnelle GO et KEGG.
    Paquets bioconda précompilés : la compilation depuis les sources échouait
    (le R de conda attend le compilateur conda, absent de l'image).
    Usage : apptainer exec cluster_profiler.sif Rscript script.R

%post
    # procps fournit "ps", utilisé par Nextflow pour mesurer les ressources
    apt-get update
    apt-get install -y --no-install-recommends procps
    rm -rf /var/lib/apt/lists/*

    micromamba install -y -p /opt/conda -c conda-forge -c bioconda \
        "r-base=3.6" \
        bioconductor-clusterprofiler=3.14.0 \
        bioconductor-org.mm.eg.db=3.10.0
    micromamba clean -a -y

%environment
    export PATH=/opt/conda/bin:$PATH

%test
    Rscript -e 'suppressMessages({library(clusterProfiler); library(org.Mm.eg.db)})' \
            -e 'cat("R:", as.character(getRversion()), "\n")' \
            -e 'cat("clusterProfiler:", as.character(packageVersion("clusterProfiler")), "\n")' \
            -e 'cat("org.Mm.eg.db:", as.character(packageVersion("org.Mm.eg.db")), "\n")'
