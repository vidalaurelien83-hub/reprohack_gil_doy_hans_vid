params {
    samplesheet = "${projectDir}/samples.csv"
    outdir = "${projectDir}/results"
    datadir = "${projectDir}/data"
}

apptainer {
    enabled = true
    autoMounts = true
}

process {
    errorStrategy = 'terminate'
    withName: DOWNLOAD_FASTQ { container = "${projectDir}/images/wget_1.21.3.sif" }
    withName: DOWNLOAD_REFERENCE { container = "${projectDir}/images/wget_1.21.3.sif" }
    withName: TRIMMOMATIC { container = "${projectDir}/images/trimmomatic_0.39.sif" }
    withName: SALMON_INDEX { container = "${projectDir}/images/salmon_1.2.0.sif" }
    withName: SALMON_QUANT { container = "${projectDir}/images/salmon_1.2.0.sif" }
    withName: DESEQ2 { container = "${projectDir}/images/deseq2_1.26.0.sif" }
    withName: CLUSTERPROFILER { container = "${projectDir}/images/cluster_profiler.sif" }
}
